{
  "ci": {
    "collect": {
      "startServerCommand": "python3 -m http.server 8080",
      "startServerReadyPattern": "Serving HTTP",
      "url": [
        "http://localhost:8080/index.html",
        "http://localhost:8080/tires.html",
        "http://localhost:8080/branches/gardens.html",
        "http://localhost:8080/faz3a.html",
        "http://localhost:8080/ar/index.html",
        "http://localhost:8080/ar/tires.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["warn", { "minScore": 0.85 }],
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "categories:best-practices": ["warn", { "minScore": 0.8 }],
        "canonical": "off",
        "is-crawlable": "off"
      }
    }
  }
}
